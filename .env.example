# Vorlage fuer lokale Secrets des Asset-Generators (tools/asset-generator).
# Kopiere diese Datei zu ".env.local" (Projekt-Root) und trage dort deinen
# echten Key ein. ".env.local" wird NIE committet (siehe .gitignore).
#
# Diese Datei (.env.example) enthaelt bewusst KEINE echten Werte und darf
# versioniert bleiben.

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
